# Welcome the user and ask for an odd number of rounds.
import random

print("Ready to play Rock Paper Scissors?!")

rounds = int(input("How many rounds would you like to play: "))

while rounds <= 0 or rounds % 2 == 0:
    print("Sorry, the number must be a positive odd number.")
    rounds = int(input("Please try again: "))

print(f"You chose {rounds} rounds. Let's play")


def get_player_choice():
    choice = input("Enter rock, paper, or scissors: ").lower()

    while choice not in ["rock", "paper", "scissors"]:
        print(f"Sorry, '{choice}' is not a valid choice. Please try again.")
        choice = input("Enter rock, paper, or scissors: ").lower()

    return choice


def determine_winner(player_choice, computer_choice):
    if player_choice == computer_choice:
        return "tie"
    elif (
        (player_choice == "rock" and computer_choice == "scissors")
        or (player_choice == "paper" and computer_choice == "rock")
        or (player_choice == "scissors" and computer_choice == "paper")
    ):
        return "win"
    else:
        return "loss"


player_wins = 0
computer_wins = 0

while player_wins + computer_wins < rounds:
    player_choice = get_player_choice()
    computer_choice = random.choice(["rock", "paper", "scissors"])
    print(f"Computer chose {computer_choice}")

    result = determine_winner(player_choice, computer_choice)

    if result == "tie":
        print("This round is a tie. Play again!")
    elif result == "win":
        print("You win this round!")
        player_wins += 1
    else:
        print("Computer wins this round!")
        computer_wins += 1


print("-------------------------------------------")
print(f"Score - You: {player_wins} | Computer: {computer_wins}")

if player_wins > computer_wins:
    print("You win!!")
else:
    print("The computer wins!")

print("Thanks for playing!")